# ============================================================
# Student Marketplace — Environment Variables
# ============================================================
# Copy this file to .env.local and fill in your values.
# NEVER commit .env.local to version control.
# ============================================================

# -----------------------------------------------------------
# App
# -----------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME="Student Marketplace"

# -----------------------------------------------------------
# Database (Supabase PostgreSQL)
# -----------------------------------------------------------
# Get from: https://app.supabase.com → Project Settings → Database
DATABASE_URL="postgresql://postgres:[PASSWORD]@db.[PROJECT_REF].supabase.co:5432/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres:[PASSWORD]@db.[PROJECT_REF].supabase.co:5432/postgres"

# -----------------------------------------------------------
# Supabase (Storage + Realtime)
# -----------------------------------------------------------
# Get from: https://app.supabase.com → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://[PROJECT_REF].supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# -----------------------------------------------------------
# NextAuth.js
# -----------------------------------------------------------
# Generate with: openssl rand -base64 32
AUTH_SECRET=your-super-secret-auth-secret-at-least-32-chars
NEXTAUTH_URL=http://localhost:3000

# -----------------------------------------------------------
# Email (Resend)
# -----------------------------------------------------------
# Get from: https://resend.com/api-keys
RESEND_API_KEY=re_your_resend_api_key
EMAIL_FROM="Student Marketplace <noreply@yourdomain.com>"

# -----------------------------------------------------------
# Admin Seed Credentials
# -----------------------------------------------------------
# Used only during database seeding — change after first login
ADMIN_EMAIL=admin@studentmarketplace.gh
ADMIN_PASSWORD=Admin@123456

# -----------------------------------------------------------
# Payment (Paystack — Ghana compatible)
# -----------------------------------------------------------
# Get from: https://dashboard.paystack.com/#/settings/developers
PAYSTACK_SECRET_KEY=sk_test_your_paystack_secret_key
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=pk_test_your_paystack_public_key

# -----------------------------------------------------------
# File Upload
# -----------------------------------------------------------
# Max file size in bytes (default: 5MB)
MAX_FILE_SIZE=5242880
